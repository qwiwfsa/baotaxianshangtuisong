    <!-- 动态加载FAQ -->
    <script>
        (async function loadFAQ() {
            try {
                const response = await fetch('admin/api/faq-data.php?t=' + Date.now());
                const result = await response.json();

                const container = document.getElementById('faqDynamicContainer');
                if (!container) return;

                if (result.code === 0 && result.data && result.data.length > 0) {
                    // 按分类分组
                    const grouped = {};
                    result.data.forEach(faq => {
                        if (!grouped[faq.category]) {
                            grouped[faq.category] = [];
                        }
                        grouped[faq.category].push(faq);
                    });

                    // 分类图标映射
                    const categoryIcons = {
                        'liangzi': 'fa-lightbulb',
                        'guoqiao': 'fa-exchange-alt',
                        'baizhang': 'fa-university',
                        'receivable': 'fa-file-invoice-dollar',
                        'deposit': 'fa-piggy-bank',
                        'general': 'fa-question-circle'
                    };

                    // 分类名称映射
                    const categoryNames = {
                        'liangzi': '亮资业务',
                        'guoqiao': '过桥资金',
                        'baizhang': '摆账业务',
                        'receivable': '应收账款融资',
                        'deposit': '银行存款',
                        'general': '一般问题'
                    };

                    // 生成HTML
                    let html = '';
                    Object.keys(grouped).forEach(category => {
                        const icon = categoryIcons[category] || 'fa-question-circle';
                        const name = categoryNames[category] || category;
                        const faqs = grouped[category];

                        html += `
                            <div class="faq-category" style="opacity: 1; transform: translateY(0px);">
                                <h3 class="faq-category-title">
                                    <i class="fas ${icon}" aria-hidden="true"></i> ${name}
                                </h3>
                                <div class="faq-list">`;

                        faqs.forEach(faq => {
                            html += `
                                <details class="faq-item">
                                    <summary class="faq-question">${faq.question}</summary>
                                    <div class="faq-answer">
                                        ${faq.answer}
                                    </div>
                                </details>`;
                        });

                        html += `
                                </div>
                            </div>`;
                    });

                    container.innerHTML = html;
                } else {
                    container.innerHTML = `
                        <div style="text-align: center; padding: 40px; color: #9ca3af;">
                            <i class="fas fa-inbox" style="font-size: 48px; margin-bottom: 16px; opacity: 0.5;"></i>
                            <p>暂无常见问题</p>
                        </div>`;
                }
            } catch (error) {
                console.error('加载FAQ失败:', error);
                const container = document.getElementById('faqDynamicContainer');
                if (container) {
                    container.innerHTML = `
                        <div style="text-align: center; padding: 40px; color: #ef4444;">
                            <i class="fas fa-exclamation-triangle" style="font-size: 32px; margin-bottom: 16px;"></i>
                            <p>加载失败，请稍后重试</p>
                        </div>`;
                }
            }
        })();
    </script>




