<a href="fenzhan-management.html" class="cms-nav-item"><i class="fas fa-building"></i><span>城市分站</span></a>
<a href="fenzhan-template.html" class="cms-nav-item"><i class="fas fa-pen-ruler"></i><span>公共模板</span></a>
</div></nav>
</aside>
<main class="cms-main">
<div class="tabs">
<div class="tab active" onclick="switchTab('files')">文件管理</div>
<div class="tab" onclick="switchTab('folders')">文件夹</div>
<div class="tab" onclick="switchTab('recycle')">回收站</div>
<div class="tab" onclick="switchTab('logs')">操作日志</div>
<div class="tab" onclick="switchTab('settings')">设置</div>
</div>
<div id="tab-files">
<div class="toolbar">
<h2>媒体库</h2>
<button class="btn btn-primary" onclick="document.getElementById('fileInput').click()"><i class="fas fa-upload"></i>上传</button>
<button class="btn btn-outline" onclick="toggleSelect()"><i class="fas fa-check-square"></i>批量</button>
<input type="file" id="fileInput" multiple hidden accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.mp4,.zip" onchange="doUpload(this.files)">
<input id="searchInput" placeholder="搜索..." style="padding:6px 12px;border:1px solid #cbd5e1;border-radius:6px;font-size:12px;width:160px" oninput="debounce(loadFiles,300)">
<select id="typeFilter" onchange="loadFiles()" style="padding:6px;border:1px solid #cbd5e1;border-radius:6px;font-size:12px">
<option value="">全部</option><option value="image">图片</option><option value="document">文档</option><option value="video">视频</option>
</select>
</div>
<div class="folder-bar" id="folderBar"></div>
<div class="upload-zone" id="dropZone" onclick="document.getElementById('fileInput').click()">
<i class="fas fa-cloud-upload-alt"></i><p>拖拽文件到此处上传</p><p style="font-size:11px;color:#94a3b8">JPG/PNG/WebP/SVG/PDF/DOC/XLS/MP4/ZIP</p>
</div>
<div class="media-grid" id="mediaGrid"></div>
<div class="empty" id="emptyState"><i class="fas fa-inbox"></i><p>暂无文件</p></div>
<div class="pagination" id="pagination"></div>
</div>
<div id="tab-folders" style="display:none">
<div class="toolbar"><h2>文件夹</h2><button class="btn btn-primary" onclick="createFolder()"><i class="fas fa-plus"></i>新建</button></div>
<div class="media-grid" id="folderGrid"></div>
</div>
<div id="tab-recycle" style="display:none">
<div class="toolbar"><h2>回收站</h2><button class="btn btn-outline btn-sm" onclick="loadRecycle()"><i class="fas fa-sync-alt"></i></button></div>
<div class="media-grid" id="recycleGrid"></div>
</div>
<div id="tab-logs" style="display:none">
<div class="toolbar"><h2>操作日志</h2></div>
<div class="table-wrap"><table><thead><tr><th>ID</th><th>文件ID</th><th>操作</th><th>详情</th><th>IP</th><th>时间</th></tr></thead><tbody id="logBody"></tbody></table></div>
<div class="pagination" id="logPagination"></div>
</div>
<div id="tab-settings" style="display:none">
<div class="toolbar"><h2>设置</h2><button class="btn btn-primary" onclick="saveSettings()">保存</button></div>
<div id="settingsForm" style="max-width:500px"></div>
</div>
</main>
</div>
<div class="batch-bar" id="batchBar">
<span id="batchCount">已选0个</span>
<button onclick="selectAll()">全选</button>
<button onclick="batchAction('move')">移动</button>
<button onclick="batchAction('delete')">删除</button>
<button class="danger" onclick="cancelSelect()">取消</button>
</div>
<div class="modal-overlay" id="modal"><div class="modal" id="modalBox"></div></div>
<div class="preview-overlay" id="previewOverlay" onclick="closePreview()"><div class="preview-content" id="previewContent"></div></div>
<div class="toast" id="toast"></div>
<script>
// Sync localStorage auth to cookie for PHP backend
if (localStorage.getItem('cms_logged_in') === 'true' && document.cookie.indexOf('cms_logged_in') === -1) {
    document.cookie = 'cms_logged_in=true;path=/;max-age=' + (60*60*24*30) + ';SameSite=Lax';
}

var A='api/media/',page=1,fid=0,tab='files',sel=new Set,sm=false;
function G(id){return document.getElementById(id)}
function api(u,o){o=o||{};return fetch(A+u,o).then(function(r){return r.json()})}
function T(m,t){var e=G('toast');e.textContent=m;e.className='toast '+(t||'success');e.style.display='block';setTimeout(function(){e.style.display='none'},2500)}
function M(h){G('modalBox').innerHTML=h;G('modal').classList.add('show')}
function H(){G('modal').classList.remove('show')}
G('modal').addEventListener('click',function(e){if(e.target===this)H()})
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function FS(b){return b<1024?b+'B':b<1048576?(b/1024).toFixed(1)+'KB':(b/1048576).toFixed(1)+'MB'}
var dt;function debounce(f,t){clearTimeout(dt);dt=setTimeout(f,t||300)}

function switchTab(t){tab=t;['files','folders','recycle','logs','settings'].forEach(function(x,i){
G('tab-'+x).style.display=x===t?'block':'none';
document.querySelectorAll('.tab')[i].classList.toggle('active',x===t);
});if(t==='files')loadFiles();else if(t==='folders')loadFolders();else if(t==='recycle')loadRecycle();else if(t==='logs')loadLogs();else if(t==='settings')loadSettings()}

function selectAll(){document.querySelectorAll('.media-card.selecting').forEach(function(c){var id=parseInt(c.getAttribute('data-id'));if(id>0){sel.add(id);c.classList.add('selected')}});updateSel()}
function previewMedia(id){var c=document.querySelector('[data-id='+id+']');if(!c)return;var u=c.getAttribute('data-url'),ft=c.getAttribute('data-ftype')||'';var pc=G('previewContent');if(ft.indexOf('video/')===0){pc.innerHTML='<video src="'+u+'" controls autoplay style="max-width:90vw;max-height:85vh;border-radius:4px"></video>'}else{pc.innerHTML='<img src="'+u+'" style="max-width:90vw;max-height:85vh;object-fit:contain;border-radius:4px" onclick=event.stopPropagation()>'}G('previewOverlay').classList.add('show');document.body.style.overflow='hidden'}
function closePreview(){G('previewOverlay').classList.remove('show');document.body.style.overflow=''}
function loadFiles(){
api('media-list.php?page='+page+'&limit=30&folder='+fid+'&search='+encodeURIComponent(G('searchInput').value)+'&type='+G('typeFilter').value).then(function(d){
if(!d.success)return;var g=G('mediaGrid'),e=G('emptyState');
if(!d.data.length){g.innerHTML='';e.style.display='block'}else{e.style.display='none'}
g.innerHTML=d.data.map(function(f){var img=f.file_type&&f.file_type.indexOf('image/')===0,
t=img?'<img class=thumb src='+(f.thumb||f.url)+'>':'<div class=\"thumb icon\"><video src=\"'+f.url+'\" muted preload=\"metadata\" style=\"width:100%;height:100%;object-fit:cover;\"></video></div>';
return '<div class=media-card'+(sm?' selecting':'')+(sel.has(f.id)?' selected':'')+' onclick=cardClick('+f.id+',event) data-id='+f.id+' data-url="'+f.url+'" data-ftype="'+f.file_type+'">'+
'<div class=check><i class=\"fas fa-check\"></i></div>'+
'<div class=actions><button onclick=\"event.stopPropagation();editMeta('+f.id+')\"><i class=fas fa-pen></i></button>'+
'<button onclick=\"event.stopPropagation();batchAction(\'delete\',['+f.id+'])\"><i class=fas fa-trash></i></button></div>'+
t+'<div class=info><div class=name title='+esc(f.original_name)+'>'+esc(f.original_name)+'</div><div class=meta><span>'+FS(f.file_size)+'</span></div></div></div>'}).join('');
var p=G('pagination');if(d.pages>1){p.innerHTML='<button onclick=page=1;loadFiles()'+(d.page<=1?' disabled':'')+'><i class=fas fa-angle-double-left></i></button>'+
'<button onclick=page='+(d.page-1)+';loadFiles()'+(d.page<=1?' disabled':'')+'><i class=fas fa-angle-left></i></button>'+
'<span>'+d.page+'/'+d.pages+'</span>'+
'<button onclick=page='+(d.page+1)+';loadFiles()'+(d.page>=d.pages?' disabled':'')+'><i class=fas fa-angle-right></i></button>'+
'<button onclick=page='+d.pages+';loadFiles()'+(d.page>=d.pages?' disabled':'')+'><i class=fas fa-angle-double-right></i></button>'}else{p.innerHTML=''}
});
api('folders.php').then(function(d){if(d.success){G('folderBar').innerHTML='<span class=\"folder-chip'+(fid===0?' active':'')+'\" onclick=fid=0;loadFiles()>全部</span>'+d.data.map(function(f){return'<span class=\"folder-chip'+(fid===f.id?' active':'')+'\" onclick=fid='+f.id+';loadFiles()>'+esc(f.name)+' ('+(f.file_count||0)+')</span>'}).join('')}})
}

function doUpload(files){if(!files||!files.length)return;var fd=new FormData();for(var i=0;i<files.length;i++)fd.append('files[]',files[i]);fd.append('folder_id',fid);T('上传中...');fetch(A+'media-upload.php',{method:'POST',body:fd}).then(function(r){return r.json()}).then(function(d){if(d.success){T(d.data.uploaded.length+'个成功');loadFiles()}else{T(d.message||'失败','error')}})}

function toggleSelect(){sm=!sm;if(!sm){sel.clear();updateSel()}document.querySelectorAll('.media-card').forEach(function(c){c.classList.toggle('selecting',sm)})}
function cardClick(id,e){if(sm){sel[sel.has(id)?'delete':'add'](id);document.querySelector('[data-id='+id+']').classList.toggle('selected',sel.has(id));updateSel()}else{previewMedia(id)}}
function updateSel(){var b=G('batchBar');b.classList.toggle('show',sel.size>0);G('batchCount').textContent='已选'+sel.size+'个'}
function cancelSelect(){sm=false;sel.clear();updateSel();document.querySelectorAll('.media-card').forEach(function(c){c.classList.remove('selecting','selected')})}
function batchAction(act,ids){ids=ids||Array.from(sel);if(!ids.length)return;if(act==='delete'&&!confirm('确定删除?'+ids.length+'个文件?'))return;
var body=JSON.stringify({ids:ids,action:act});if(act==='move'){api('folders.php').then(function(d){if(!d.success)return;
M('<h3>移动到</h3><select id=mvTarget>'+d.data.map(function(f){return'<option value='+f.id+'>'+esc(f.name)+'</option>'}).join('')+'</select><div class=modal-btns><button class=\"btn btn-outline\" onclick=H()>取消</button><button class=\"btn btn-primary\" onclick=doMove()>确定</button></div>')})}else if(act==='restore'){api('batch.php',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids:ids,action:'restore'})}).then(function(d){if(d.success){T('已恢复');cancelSelect();loadRecycle()}})}
else if(act==='permanent_delete'&&confirm('永久删除不可恢复，确定?')){api('batch.php',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids:ids,action:'permanent_delete'})}).then(function(d){if(d.success){T('已删除');cancelSelect();loadRecycle()}})}
else{api('batch.php',{method:'POST',headers:{'Content-Type':'application/json'},body:body}).then(function(d){if(d.success){T('完成');cancelSelect();loadFiles()}})}}
function doMove(){var fid=parseInt(G('mvTarget').value);api('batch.php',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids:Array.from(sel),action:'move',folder_id:fid})}).then(function(d){if(d.success){T('移动成功');cancelSelect();loadFiles();H()}})}

function editMeta(id){api('media-list.php?page=1&limit=1').then(function(d){var f=d.data.find(function(x){return x.id===id});if(!f)return;
M('<h3>编辑</h3><label>文件名</label><input value=\"'+esc(f.original_name)+'\" readonly><label>SEO Alt</label><input id=emAlt value=\"'+esc(f.alt_text||'')+'\"><label>标题</label><input id=emTitle value=\"'+esc(f.title||'')+'\"><label>文件夹</label><select id=emFid><option value=0>根目录</option></select><div class=modal-btns><button class=\"btn btn-outline\" onclick=H()>取消</button><button class=\"btn btn-primary\" onclick=saveMeta('+id+')>保存</button></div>');
api('folders.php').then(function(d2){if(d2.success)d2.data.forEach(function(fd){G('emFid').innerHTML+='<option value='+fd.id+(fd.id===f.folder_id?' selected':'')+'>'+esc(fd.name)+'</option>'})})})}
function saveMeta(id){var d={id:id,alt_text:G('emAlt').value,title:G('emTitle').value,folder_id:parseInt(G('emFid').value)};
api('media-list.php',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)}).then(function(r){return r.json()}).then(function(d2){if(d2.success){T('已保存');H();loadFiles()}})}

function loadRecycle(){api('media-list.php?recycle=1&limit=100').then(function(d){if(!d.success)return;var g=G('recycleGrid');
g.innerHTML=d.data.map(function(f){return'<div class=media-card><div class=\"thumb icon\"><i class=\"fas fa-file\"></i></div><div class=info><div class=name>'+esc(f.original_name)+'</div><div class=meta>'+FS(f.file_size)+'</div></div><div class=actions style=display:flex>'+
'<button onclick=batchAction(\'restore\',['+f.id+'])><i class=fas fa-undo></i></button><button onclick=batchAction(\'permanent_delete\',['+f.id+'])><i class=fas fa-times></i></button></div></div>'}).join('')})}

function loadLogs(){api('logs.php?page=1&limit=50').then(function(d){if(!d.success)return;G('logBody').innerHTML=d.data.map(function(l){return'<tr><td>'+l.id+'</td><td>'+l.media_id+'</td><td>'+l.action+'</td><td>'+esc(l.detail)+'</td><td>'+l.ip+'</td><td>'+l.created_at+'</td></tr>'}).join('')})}

function loadFolders(){api('folders.php').then(function(d){if(!d.success)return;G('folderGrid').innerHTML=d.data.map(function(f){return'<div class=media-card style=padding:16px;text-align:center><i class=fas fa-folder style=font-size:40px;color:#f59e0b></i><div style=margin-top:8px;font-weight:500 id="fn_'+f.id+'">'+esc(f.name)+'</div><div style=font-size:11px;color:#94a3b8>'+f.file_count+'文件</div>'+(f.id>1?'<button class=\"btn btn-sm btn-outline\" style=margin-top:8px onclick=renameFolder('+f.id+')><i class=fas fa-pen></i></button><button class="btn btn-sm btn-outline" onclick=delFolder('+f.id+')><i class=fas fa-trash></i></button>':'')+'</div>'}).join('')})}
function renameFolder(id){var el=G('fn_'+id);if(!el)return;var old=el.textContent;el.innerHTML='<input class=folder-rename-inp id=rn_'+id+' value="'+esc(old)+'" onkeydown="if(event.key===\'Enter\')doRenameFolder('+id+');if(event.key===\'Escape\')loadFolders()" onblur="doRenameFolder('+id+')">';setTimeout(function(){var inp=G('rn_'+id);if(inp){inp.focus();inp.select()}},100)}
function doRenameFolder(id){var inp=G('rn_'+id);var n=inp?inp.value.trim():'';if(!n||n.length>50){loadFolders();return}api('folders.php',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id,name:n})}).then(function(d){if(d.success){T('已重命名');loadFolders();loadFiles()}else{T(d.message||'失败','error');loadFolders()}})}
function createFolder(){M('<h3>新建文件夹</h3><label>名称</label><input id=nfName><div class=modal-btns><button class=\"btn btn-outline\" onclick=H()>取消</button><button class=\"btn btn-primary\" onclick=doCreateFolder()>创建</button></div>')}
function doCreateFolder(){var n=G('nfName').value.trim();if(!n)return;api('folders.php',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:n})}).then(function(d){if(d.success){T('已创建');H();loadFolders();loadFiles()}})}
function delFolder(id){if(!confirm('删除文件夹？文件移至默认分类。'))return;api('folders.php',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id})}).then(function(d){if(d.success){T('已删除');loadFolders();loadFiles()}})}

function loadSettings(){api('settings.php').then(function(d){if(!d.success)return;var s=d.data;var fs=[{k:'compression_quality',l:'压缩质量(1-100)',t:'number'},{k:'max_width',l:'最大宽度(px)',t:'number'},{k:'max_height',l:'最大高度(px)',t:'number'},{k:'webp_enabled',l:'WebP转换',t:'select',o:{0:'关闭',1:'开启'}},{k:'watermark_enabled',l:'水印',t:'select',o:{0:'关闭',1:'开启'}},{k:'watermark_text',l:'水印文字',t:'text'},{k:'exif_remove',l:'清除EXIF',t:'select',o:{0:'关闭',1:'开启'}},{k:'cdn_enabled',l:'CDN',t:'select',o:{0:'关闭',1:'开启'}},{k:'cdn_url',l:'CDN域名',t:'text'}];
G('settingsForm').innerHTML=fs.map(function(f){var v=s[f.k]||'',i=f.t==='select'?'<select id=s_'+f.k+'>'+Object.entries(f.o||{}).map(function(o){return'<option value='+o[0]+(String(v)===o[0]?' selected':'')+'>'+o[1]+'</option>'}).join('')+'</select>':'<input id=s_'+f.k+' type='+f.t+' value='+v+'>';return'<label>'+f.l+'</label>'+i}).join('')})}
function saveSettings(){var d={};['compression_quality','max_width','max_height','webp_enabled','watermark_enabled','watermark_text','exif_remove','cdn_enabled','cdn_url'].forEach(function(k){var e=G('s_'+k);if(e)d[k]=e.value});api('settings.php',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)}).then(function(r){return r.json()}).then(function(d2){if(d2.success)T('已保存')})}

var dz=G('dropZone');dz.addEventListener('dragover',function(e){e.preventDefault();dz.classList.add('drag-over')});dz.addEventListener('dragleave',function(){dz.classList.remove('drag-over')});dz.addEventListener('drop',function(e){e.preventDefault();dz.classList.remove('drag-over');doUpload(e.dataTransfer.files)});

loadFiles();
</script>
</body>
</html>
