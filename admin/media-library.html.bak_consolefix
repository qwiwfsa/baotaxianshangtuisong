<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>媒体库 - CMS管理后台</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;background:#f3f4f6;min-height:100vh}
.cms-layout{display:flex;min-height:100vh}
.cms-sidebar{width:240px;background:#1e293b;position:fixed;top:0;left:0;bottom:0;overflow-y:auto;z-index:100;color:#e2e8f0}
.cms-sidebar-header{padding:20px 24px;border-bottom:1px solid #334155}
.cms-sidebar-brand{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:600;color:#fff}
.cms-sidebar-brand i{font-size:18px;color:#3b82f6}
.cms-sidebar-nav{padding:16px 0}
.cms-nav-section{margin-bottom:8px}
.cms-nav-title{padding:12px 24px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:#94a3b8}
.cms-nav-item{display:flex;align-items:center;gap:12px;padding:12px 24px;color:#cbd5e1;text-decoration:none;font-size:14px;transition:all .2s;cursor:pointer}
.cms-nav-item:hover{background:#334155;color:white}
.cms-nav-item.active{background:#334155;color:white;border-left:3px solid #3b82f6}
.cms-nav-item i{width:18px;text-align:center}
.cms-main{flex:1;margin-left:240px;padding:24px}
.toolbar{display:flex;align-items:center;gap:12px;margin-bottom:20px;flex-wrap:wrap;background:#fff;padding:16px 20px;border-radius:10px;border:1px solid #e2e8f0}
.toolbar h2{font-size:18px;font-weight:600;color:#1e293b;margin-right:auto}
.btn{padding:8px 16px;border:none;border-radius:6px;font-size:13px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;font-weight:500;transition:all .15s}
.btn-primary{background:#3b82f6;color:#fff}.btn-primary:hover{background:#2563eb}
.btn-outline{background:#fff;color:#334155;border:1px solid #cbd5e1}.btn-outline:hover{background:#f8fafc}
.btn-danger{background:#ef4444;color:#fff}.btn-danger:hover{background:#dc2626}
.btn-sm{padding:5px 10px;font-size:12px}
.upload-zone{border:2px dashed #cbd5e1;border-radius:10px;padding:32px;text-align:center;background:#fff;margin-bottom:20px;cursor:pointer;transition:all .2s;color:#64748b}
.upload-zone:hover,.upload-zone.drag-over{border-color:#3b82f6;background:#eff6ff;color:#3b82f6}
.upload-zone i{font-size:40px;margin-bottom:8px;display:block}
.folder-bar{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}
.folder-chip{padding:5px 14px;border-radius:20px;font-size:12px;cursor:pointer;background:#fff;border:1px solid #e2e8f0;color:#475569}
.folder-chip.active{background:#3b82f6;color:#fff;border-color:#3b82f6}
.media-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px}
.media-card{background:#fff;border-radius:8px;overflow:hidden;border:1px solid #e2e8f0;cursor:pointer;transition:all .15s;position:relative}
.media-card:hover{border-color:#3b82f6;box-shadow:0 4px 12px rgba(0,0,0,.08)}
.media-card.selected{border-color:#3b82f6;box-shadow:0 0 0 2px rgba(59,130,246,.3)}
.media-card .check{position:absolute;top:6px;left:6px;z-index:2;width:20px;height:20px;border-radius:4px;background:rgba(255,255,255,.9);display:none;align-items:center;justify-content:center;font-size:11px;color:#3b82f6}
.media-card.selecting .check,.media-card.selected .check{display:flex}
.media-card.selected .check{background:#3b82f6;color:#fff}
.media-card .thumb{width:100%;height:130px;object-fit:cover;display:block;background:#f1f5f9}
.media-card .thumb.icon{display:flex;align-items:center;justify-content:center;font-size:40px;color:#94a3b8}
.media-card .info{padding:6px 8px}
.media-card .name{font-size:11px;color:#334155;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.media-card .meta{font-size:10px;color:#94a3b8;margin-top:2px;display:flex;justify-content:space-between}
.media-card .actions{position:absolute;top:4px;right:4px;display:none;gap:2px}
.media-card:hover .actions{display:flex}
.media-card .actions button{width:26px;height:26px;border:none;border-radius:4px;background:rgba(0,0,0,.5);color:#fff;cursor:pointer;font-size:11px}
.batch-bar{display:none;position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#0f172a;color:#fff;padding:10px 24px;border-radius:10px;z-index:200;gap:12px;align-items:center}
.batch-bar.show{display:flex}.batch-bar button{background:transparent;border:1px solid rgba(255,255,255,.3);color:#fff;padding:5px 12px;border-radius:6px;cursor:pointer;font-size:12px}
.batch-bar .danger{background:#ef4444;border-color:#ef4444}
.modal-overlay{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.4);z-index:300;align-items:center;justify-content:center}
.modal-overlay.show{display:flex}
.modal{background:#fff;border-radius:12px;padding:24px;width:480px;max-width:90vw;max-height:80vh;overflow-y:auto}
.modal h3{font-size:16px;margin-bottom:16px}.modal label{display:block;font-size:12px;font-weight:500;color:#475569;margin-bottom:4px;margin-top:12px}
.modal input,.modal select,.modal textarea{width:100%;padding:8px 12px;border:1px solid #cbd5e1;border-radius:6px;font-size:13px}
.modal-btns{display:flex;gap:8px;margin-top:20px;justify-content:flex-end}.preview-overlay{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.85);z-index:350;align-items:center;justify-content:center}.preview-overlay.show{display:flex}.preview-content{max-width:90vw;max-height:90vh}.preview-content img,.preview-content video{max-width:90vw;max-height:85vh;object-fit:contain;border-radius:4px}.folder-rename-inp{padding:4px 8px;border:1px solid #3b82f6;border-radius:4px;font-size:12px;width:100px;text-align:center}
.tabs{display:flex;border-bottom:2px solid #e2e8f0;margin-bottom:20px}
.tab{padding:10px 20px;font-size:13px;color:#64748b;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px}
.tab.active{color:#3b82f6;border-bottom-color:#3b82f6;font-weight:600}
.table-wrap{background:#fff;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0}
.table-wrap table{width:100%;border-collapse:collapse}
.table-wrap td,.table-wrap th{padding:10px 14px;font-size:12px;text-align:left;border-bottom:1px solid #f1f5f9}
.table-wrap th{background:#f8fafc;font-weight:600;color:#475569}
.table-wrap tr:hover td{background:#f8fafc}
.toast{position:fixed;top:20px;right:20px;z-index:400;padding:10px 18px;border-radius:8px;color:#fff;font-size:13px;display:none;animation:slideIn .3s}
.toast.success{background:#10b981}.toast.error{background:#ef4444}
@keyframes slideIn{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}
.pagination{display:flex;justify-content:center;gap:6px;margin-top:16px}
.pagination button{padding:5px 10px;border:1px solid #cbd5e1;background:#fff;border-radius:4px;cursor:pointer;font-size:12px}
.empty{text-align:center;padding:50px;color:#94a3b8}.empty i{font-size:40px;margin-bottom:10px;display:block}
@media(max-width:768px){.cms-sidebar{display:none}.cms-main{margin-left:0}}
</style>
</head>
<body>
<div class="cms-layout">
<aside class="cms-sidebar">
<div class="cms-sidebar-header"><div class="cms-sidebar-brand"><i class="fas fa-cog"></i><span>CMS管理后台</span></div></div>
<nav class="cms-sidebar-nav"><div class="cms-nav-section"><div class="cms-nav-title">菜单</div>
<a href="dashboard.html" class="cms-nav-item"><i class="fas fa-home"></i><span>仪表板</span></a>
<a href="logo-settings.html" class="cms-nav-item"><i class="fas fa-image"></i><span>Logo设置</span></a>
<a href="seo-settings.html" class="cms-nav-item"><i class="fas fa-search"></i><span>SEO设置</span></a>
<a href="case-management.html" class="cms-nav-item"><i class="fas fa-trophy"></i><span>案例管理</span></a>
<a href="page-manager.html" class="cms-nav-item"><i class="fas fa-list"></i><span>页面列表</span></a>
<a href="visual-page-builder.html" class="cms-nav-item"><i class="fas fa-pen-ruler"></i><span>页面设计</span></a>
<a href="visual-editor-v3.html" class="cms-nav-item"><i class="fas fa-paint-brush"></i><span>可视化编辑器</span></a>
<a href="nav-management.html" class="cms-nav-item"><i class="fas fa-bars"></i><span>导航菜单</span></a>
<a href="components/news/article-list.html" class="cms-nav-item"><i class="fas fa-newspaper"></i><span>文章管理</span></a>
<a href="faq-management.html" class="cms-nav-item"><i class="fas fa-question-circle"></i><span>FAQ管理</span></a>
